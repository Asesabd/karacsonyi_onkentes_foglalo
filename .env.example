# PostgreSQL connection string (managed Postgres in production, e.g. Neon/Railway/Supabase)
DATABASE_URL="postgresql://user:password@localhost:5432/xmas_booking?schema=public"

# Secret used to sign admin session JWTs. Generate with: openssl rand -base64 48
ADMIN_SESSION_SECRET="change-me-to-a-long-random-string"

# Seed-time admin credentials (only used by `npm run seed`; change the password after first login
# is not supported yet, so pick a strong one and rotate by re-seeding with a new value).
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-strong-password"

# Resend (https://resend.com) API key used to send booking confirmation emails.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
# "From" address must be a domain verified in Resend.
EMAIL_FROM="Karacsonyi Onkentes Program <onkentes@example.com>"

# Shared secret required (as ?secret=) to call the cron maintenance endpoints.
CRON_SECRET="change-me-to-a-long-random-string"

# Public base URL of the deployed app (used in emails / absolute links).
NEXT_PUBLIC_APP_URL="http://localhost:3000"
